  "description": "Bulk asynchronous file-based API used to verify whether phone numbers are registered on Telegram.",
  "canonical_docs": "https://docs.checknumber.ai/telegram-bulk-number-checker",
  "dashboard": "https://platform.checknumber.ai",
  "base_url": "https://api.checknumber.ai",
  "auth": {
    "type": "api_key",
    "header": "X-API-Key"
  },
  "endpoints": {
    "create_task": {
      "method": "POST",
      "path": "/v1/tasks"
    },
    "get_task": {
      "method": "POST",
      "path": "/v1/gettasks"
    },
    "balance": {
      "method": "GET",
      "path": "/v1/balance"
    }
  },
  "input": {
    "file_format": "text; one E.164 phone number per line, or one email per line for email task types"
  },
  "result_fields": [
    {
      "field": "Number",
      "description": "Phone number in E.164 format",
      "example": "+41798284651"
    },
    {
      "field": "telegram",
      "description": "Whether number has active Telegram account",
      "example": "yes, no"
    }
  ],
